"    background-color: rgba(255, 255, 255, 0.05); /* Very subtle glass */\n"
"    \n"
"    border-radius: 20px;\n"
"    background: transparent;\n"
"    \n"
"    transition: all 0.3s ease; /* Smooth transition */\n"
"}\n"
"\n"
"/* 2. Hover State (Glow) */\n"
"\n"
"\n"
"/* 3. Pressed State (Click Depth) */\n"
