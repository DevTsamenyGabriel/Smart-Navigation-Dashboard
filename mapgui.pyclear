"    }\n"
"\n"
"/* 2. The Main Scrollbar Track */\n"
"       #MymusiclistWidget QScrollBar:vertical {\n"
"        border: none;\n"
"        background: rgba(40, 20, 80, 100); /* Dark purple transparent track */\n"
"        width: 6px; /* Very slim */\n"
"        margin: 0px 0px 0px 0px;\n"
"        border-radius: 3px;\n"
"    }\n"
"\n"
"    /* 3. The Draggable Handle (The \"Thumb\") */\n"
"       #MymusiclistWidget QScrollBar::handle:vertical {\n"
"        background: #a855f7; /* Matching your music slider purple */\n"
"        min-height: 30px;\n"
"        border-radius: 3px;\n"
"    }\n"
"\n"
"    /* 4. Handle Hover Color */\n"
"       #MymusiclistWidget QScrollBar::handle:vertical:hover {\n"
"        background: #c084fc; /* Slightly lighter on hover */\n"
"    }\n"
"\n"
"    /* 5. Hide the arrows (Top and Bottom buttons) */\n"
"       #MymusiclistWidget QScrollBar::add-line:vertical, \n"
"       #MymusiclistWidget QScrollBar::sub-line:vertical {\n"
"        border: none;\n"
"        background: none;\n"
"        height: 0px;\n"
"    }\n"
"\n"
"    /* 6. Fix the \"background\" area behind the arrows */\n"
"       #MymusiclistWidget QScrollBar::up-arrow:vertical, \n"
"       #MymusiclistWidget QScrollBar::down-arrow:vertical {\n"
"        background: none;\n"
"    }\n"
"    \n"
"       #MymusiclistWidget QScrollBar::add-page:vertical, \n"
