       <property name="styleSheet">
        <string notr="true">QProgressBar {
    border: 1px solid rgba(255, 255, 255, 0.2); /* Subtle glass border */
    border-radius: 10px;
    background-color: rgba(40, 20, 60, 150); /* Dark Deep Purple Track */
    text-align: center;
    color: white; /* Progress percentage color */
    font-weight: bold;
    height: 20px;
}

QProgressBar::chunk {
    /* The &quot;Moving&quot; part - Neon Magenta to Amethyst Gradient */
    background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0, 
        stop:0 #ff00ff, 
        stop:1 #8a2be2); 
    border-radius: 8px; /* Slightly smaller than the main bar for a clean look */
    margin: 2px; /* Adds a tiny gap between the bar and the border */
}</string>
