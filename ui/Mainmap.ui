                            <item row="1" column="0">
                             <widget class="QListWidget" name="MymusiclistWidget">
                              <property name="maximumSize">
                               <size>
                                <width>380</width>
                                <height>351</height>
                               </size>
                              </property>
                              <property name="styleSheet">
                               <string notr="true">#MymusiclistWidget{


 border-radius:5px;
 color:qlineargradient(x1:0, y1:0, x2:1, y2:1, 
        stop:0 #a855f7, 
        stop:1 #6b21a8); 

}
#MymusiclistWidget {
        border: none;
        color: #a855f7; /* This is the vibrant purple from your slider */
        outline: none;
    }
    #MymusiclistWidget::item {
        padding: 10px;
        border-bottom: 1px solid rgba(170, 85, 255, 30); /* Subtle separator line */
    }
    #MymusiclistWidget::item:selected {
        background-color: rgba(170, 85, 255, 60); /* Purple highlight when clicked */
        color: white; /* Text turns white when selected for contrast */
        border-radius: 5px;
    }

/* 2. The Main Scrollbar Track */
       #MymusiclistWidget QScrollBar:vertical {
        border: none;
        background: rgba(40, 20, 80, 100); /* Dark purple transparent track */
        width: 6px; /* Very slim */
        margin: 0px 0px 0px 0px;
        border-radius: 3px;
    }

    /* 3. The Draggable Handle (The &quot;Thumb&quot;) */
       #MymusiclistWidget QScrollBar::handle:vertical {
        background: #a855f7; /* Matching your music slider purple */
        min-height: 30px;
        border-radius: 3px;
    }

    /* 4. Handle Hover Color */
       #MymusiclistWidget QScrollBar::handle:vertical:hover {
        background: #c084fc; /* Slightly lighter on hover */
    }

    /* 5. Hide the arrows (Top and Bottom buttons) */
       #MymusiclistWidget QScrollBar::add-line:vertical, 
       #MymusiclistWidget QScrollBar::sub-line:vertical {
        border: none;
        background: none;
        height: 0px;
    }

    /* 6. Fix the &quot;background&quot; area behind the arrows */
       #MymusiclistWidget QScrollBar::up-arrow:vertical, 
       #MymusiclistWidget QScrollBar::down-arrow:vertical {
        background: none;
    }
    
       #MymusiclistWidget QScrollBar::add-page:vertical, 
       #MymusiclistWidget QScrollBar::sub-page:vertical {
        background: none;
    }</string>
                              </property>
                             </widget>
