                           <property name="styleSheet">
                            <string notr="true">
/* The background track - Darkened purple transparency */
#MusichorizontalSlider::groove:horizontal {
    border: 1px solid rgba(130, 80, 220, 50);
    height: 6px;
    background: rgba(80, 40, 120, 40);
    margin: 2px 0;
    border-radius: 3px;
}

/* The sliding knob - Vibrant Purple Gradient */
#MusichorizontalSlider::handle:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, 
        stop:0 #a855f7, 
        stop:1 #6b21a8); 
    border: 1px solid #d8b4fe;
    width: 18px;
    height: 18px;
    margin: -6px 0; 
    border-radius: 9px;
}

/* The part before the handle - Solid Glowing Purple */
#MusichorizontalSlider::sub-page:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, 
        stop:0 #7c3aed, 
        stop:1 #a855f7);
    border-radius: 3px;
}





</string>
